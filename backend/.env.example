# =========================
# Sentinel provider keys
# =========================
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =========================
# Models
# =========================
GEMINI_LOW_MODEL=gemini-3.5-flash-lite
GEMINI_MEDIUM_MODEL=gemini-3.8-flash
OPENROUTER_HIGH_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# =========================
# Routing thresholds (0-100)
# =========================
MEDIUM_THRESHOLD=40
HIGH_THRESHOLD=70

# =========================
# Local app
# SQLite is the default: no Docker required.
# For PostgreSQL later, use for example:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/sentinel
# =========================
DATABASE_URL=sqlite:///./sentinel.db
FRONTEND_ORIGIN=http://localhost:3000

# =========================
# Paid-equivalent reference pricing snapshot
# USD per 1M tokens. Keep configurable because prices change.
# =========================
GEMINI_LOW_INPUT_USD_PER_MILLION=0.30
GEMINI_LOW_OUTPUT_USD_PER_MILLION=2.50
GEMINI_MEDIUM_INPUT_USD_PER_MILLION=0.75
GEMINI_MEDIUM_OUTPUT_USD_PER_MILLION=3.75
OPENROUTER_HIGH_INPUT_USD_PER_MILLION=0.0
OPENROUTER_HIGH_OUTPUT_USD_PER_MILLION=0.0
BASELINE_INPUT_USD_PER_MILLION=0.75
BASELINE_OUTPUT_USD_PER_MILLION=3.75

REQUEST_TIMEOUT_SECONDS=90
